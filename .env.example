# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (milestone 3+). Anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map adapter: "none" (list only) or "maplibre". See docs/MAPS.md
NEXT_PUBLIC_MAP_PROVIDER=none
# Vector style URL from your tile provider (the key inside it is public: restrict it by domain)
NEXT_PUBLIC_MAP_STYLE_URL=

# Dev only: extra hosts allowed to load the dev server (phone on Wi-Fi), comma separated
DEV_ALLOWED_ORIGINS=

# Dev-only auth mock. Ignored and rejected when NODE_ENV=production.
AUTH_MOCK_MODE=false
